{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Litematica Nova",
    "version": "0.1.0",
    "identifier": "com.litematica.nova",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://127.0.0.1:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "LitematicaBA",
                "width": 960,
                "height": 600,
                "minWidth": 320,
                "minHeight": 240
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": ["icons/icon.ico"]
    }
}
