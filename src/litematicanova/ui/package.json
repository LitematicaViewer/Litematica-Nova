{
    "name": "litematica-nova-desktop-ui",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1 --port 1420",
        "build": "tsc && vite build",
        "preview": "vite preview --host 127.0.0.1 --port 1421",
        "tauri": "node ./run-tauri-with-rust-path.mjs",
        "tauri:dev": "node ./run-tauri-with-rust-path.mjs dev -c platform/tauri/tauri.conf.json",
        "tauri:build": "node ./run-tauri-with-rust-path.mjs build -c platform/tauri/tauri.conf.json",
        "tauri:info": "node ./run-tauri-with-rust-path.mjs info"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.0.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.0.0",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.1",
        "typescript": "^5.5.4",
        "vite": "^5.4.0"
    }
}
