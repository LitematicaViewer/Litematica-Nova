{
    "name": "desktop-nova",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1 --port 1430",
        "build": "tsc && vite build",
        "check:layers": "node scripts/check-layer-boundaries.mjs --mode=baseline",
        "check:layers:strict": "node scripts/check-layer-boundaries.mjs --mode=strict",
        "check:layers:update-baseline": "node scripts/check-layer-boundaries.mjs --write-baseline",
        "check:application-boundaries": "node scripts/check-application-boundaries.mjs",
        "test:layer-check": "node --test scripts/check-layer-boundaries.test.mjs",
        "test:application-boundaries": "node --test scripts/check-application-boundaries.test.mjs",
        "preview": "vite preview --host 127.0.0.1 --port 1431",
        "tauri": "tauri",
        "tauri:dev": "tauri dev",
        "tauri:build": "tauri build",
        "tauri:info": "tauri info"
    },
    "dependencies": {
        "@tauri-apps/api": "2.11.1",
        "@tauri-apps/plugin-dialog": "2.7.0",
        "@tauri-apps/plugin-shell": "2.3.5",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.0",
        "lucide-react": "^0.300.0",
        "radix-ui": "^1.4.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "7.18.4",
        "tailwind-merge": "^3.4.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.1.18",
        "@tauri-apps/cli": "2.11.5",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "5.2.0",
        "jsdom": "27.4.0",
        "tailwindcss": "^4.1.18",
        "typescript": "^5.5.4",
        "vite": "7.3.7"
    }
}
