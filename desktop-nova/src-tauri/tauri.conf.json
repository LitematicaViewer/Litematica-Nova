{
  "productName": "Litematica Nova",
  "mainBinaryName": "Litematica-Nova",
  "version": "0.1.1",
  "identifier": "com.litematica.nova",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Litematica-Nova",
        "width": 854,
        "height": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Litematica-Nova",
    "shortDescription": "Litematica-Nova desktop viewer for Minecraft .litematic projections",
    "longDescription": "Litematica-Nova manages, analyzes, builds, and renders Minecraft .litematic projections.",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer/nsis-hooks.nsh"
      },
      "wix": {
        "upgradeCode": "30d2825f-22c4-594d-a998-8bbede2e81d3",
        "fragmentPaths": [
          "installer/legacy-name-cleanup.wxs"
        ],
        "componentGroupRefs": [
          "LegacyNameCleanup"
        ]
      }
    },
    "resources": {
      "../../pack-in/enumerator": "pack-in/enumerator",
      "../../pack-in/flake": "pack-in/flake",
      "../../pack-in/lang/zh_cn.json": "pack-in/lang/zh_cn.json",
      "../../pack-in/item-icons-26.3": "pack-in/item-icons-26.3",
      "../../data/generation-templates": "data/generation-templates",
      "../../data/minecraft_blockstates": "data/minecraft_blockstates",
      "gen/block-icons": "block",
      "../../bin/public-beta": "bin/public-beta",
      "../../tools/viewer-core/target/public-beta/release/stockpile_server.exe": "bin/stockpile-server/windows-x64/stockpile_server.exe",
      "../../tools/windows-thumbnail-provider/target/release/litematica_thumbnail.dll": "litematica_thumbnail.dll",
      "../../LICENSE": "licenses/LICENSE",
      "../../docs/THIRD_PARTY_UI.md": "licenses/THIRD_PARTY_UI.md",
      "../../docs/THIRD_PARTY_NOTICES.txt": "licenses/THIRD_PARTY_NOTICES.txt",
      "../../pack-in/materials/minecraft-26.3.json": "pack-in/materials/minecraft-26.3.json"
    },
    "createUpdaterArtifacts": true
  },
