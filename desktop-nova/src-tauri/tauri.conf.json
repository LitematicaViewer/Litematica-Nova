      "endpoints": [
        "https://raw.githubusercontent.com/LitematicaViewer/Litematica-Nova/main/updates/latest.json",
        "https://45-62-112-121.sslip.io:8448/nova-updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
